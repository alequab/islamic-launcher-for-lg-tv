#!/bin/sh
# Afnon Launcher: run by Homebrew Channel at every boot (run-parts /var/lib/webosbrew/init.d).
#  1. Lets the launcher list and open apps, read the network name and use its own service
#     (tv.afnon.launcher.service, which schedules the adhan): an installed web app gets only the "public" group,
#     which refuses all of these. Written again at every boot and after any install, since a reinstall resets it.
#     The service may also see which app is on screen, so after the adhan the launcher goes back to it.
#  2. Brings Afnon to the front once the TV's first app is up, and again every time the TV turns on: with
#     Quick Start+ turning on is a wake from standby, not a boot, so this script would not run then.
#  3. Copies the apps' icons into the launcher's folder, now and whenever an app comes or goes.
#  4. As the TV turns off, makes Afnon its "last input", so the TV opens Afnon first when it turns on again.
#     If an HDMI input was on screen when it went off, the TV wakes to it for about a second before Afnon.
#  5. Keeps the launcher up to date from its GitHub releases (once a day; straight from GitHub, no server in
#     between), and this script with it. The releases carry no adhan or voice recordings (they have no licence),
#     so the launcher's sounds are kept aside and put back after every install.
# Install: copy to /var/lib/webosbrew/init.d/ and chmod +x (tools/install-tv.ps1 does both).
#  6. Becomes the TV's Home: a stand-in is mounted (in RAM) over LG's Home program, so the Home key and the end
#     of every app open the launcher, with no LG bar. LG's Home comes back by itself if the stand-in fails.
#  7. While it is Home, keeps LG's ads, viewing tracking (LivePlus), telemetry logs and suggestions from running
#     (do-nothing stubs mounted in RAM, ad servers in a RAM copy of /etc/hosts). Nothing on disk is changed: a
#     restart without this script leaves the TV as it was. Ideas from lasharor's cleanyourtv-WebOS (MIT).
# By hand: `90-afnon-launcher update` checks for an update now; `90-afnon-launcher lg-home` gives Home back to LG
# until the next restart (touch /var/lib/afnon-launcher/no-home to keep it so; no-debloat for the clean-up).

APP=tv.afnon.launcher
PERM=/var/luna-service2-dev/client-permissions.d/$APP.app.json
WANT='{"tv.afnon.launcher-*":["public","applications","applications.internal","applications.launch","applications.query","networking.query","tv.afnon.launcher.service.group"]}'
LOG=/tmp/afnon-launcher.log
PID=/tmp/afnon-launcher.pid

log() { echo "$(date +%H:%M:%S) $*" >> $LOG; }

# The launcher's service may also see which app is on screen when the adhan comes, so the launcher goes back to it
# after the call (an HDMI input, YouTube…).
SPERM=/var/luna-service2-dev/client-permissions.d/tv.afnon.launcher.service.service.json
# (getForegroundAppInfo is in "applications.internal", not "applications.query".)
SWANT='{"tv.afnon.launcher.service*":["public","applications.internal"]}'

perms() {
  changed=
  if [ -f "$PERM" ] && [ "$(cat $PERM)" != "$WANT" ]; then echo "$WANT" > $PERM; changed=1; fi
  if [ -f "$SPERM" ] && [ "$(cat $SPERM)" != "$SWANT" ]; then echo "$SWANT" > $SPERM; changed=1; fi
  [ -n "$changed" ] && { ls-control scan-services >/dev/null 2>&1; log "permissions set"; }
}
perms

# The apps' icons, copied into the launcher's own folder: a web app may not read files in other apps' folders.
DIR=/media/developer/apps/usr/palm/applications/$APP
icons() {
  [ -d $DIR ] || return
  mkdir -p $DIR/icons
  luna-send -n 1 -f luna://com.webos.applicationManager/listLaunchPoints '{}' 2>/dev/null |
    awk -F'"' '/^ *"id": /{id=$4} /^ *"icon": /{ic=$4} id != "" && ic != "" {print id, ic; id=""; ic=""}' |
    while read -r id ic; do cp "$ic" "$DIR/icons/$id.png" 2>/dev/null; done
  # The TV's own apps that its launch list leaves out (EXTRA_APPS in app.js).
  for a in com.webos.app.livetv:assets/icon_livetv_80.png com.webos.app.hdmi1:icon.png \
           com.webos.app.hdmi2:icon.png com.palm.app.settings:icon.png; do
    cp "/usr/palm/applications/${a%%:*}/${a#*:}" "$DIR/icons/${a%%:*}.png" 2>/dev/null
  done
}
icons

# The TV opens its "last input" first when it turns on (bootd.json: firstAppInNormal = {LAST_INPUT_APP}, from the
# setting lastInputApp; a web app like Afnon never becomes it by itself). Pointing it at Afnon each time the TV
# goes off makes Afnon the first thing on screen, with no HDMI or Live TV before it.
first() {
  luna-send -n 1 luna://com.webos.settingsservice/setSystemSettings \
    "{\"category\":\"general\",\"settings\":{\"lastInputApp\":\"$APP\"}}" >/dev/null 2>&1
}

front() {
  luna-send -n 1 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null |
    sed -n 's/.*"appId": *"\([^"]*\)".*/\1/p'
}

launch() {
  luna-send -n 1 luna://com.webos.applicationManager/launch "{\"id\":\"$APP\"}" 2>/dev/null | grep -q '"returnValue":true'
}

# Opens Afnon at once, then for 20 s puts it back on top whenever the TV's own input apps (its last HDMI input,
# Live TV) or its Home come up over it, as they do while the TV starts. Stops early if another app is opened.
bring() {
  log "bring (front: $(front))"
  # Early in a boot the application manager may not take it yet: ask again every half second, 30 s at most.
  i=0
  until launch || [ $i -ge 60 ]; do usleep 500000 2>/dev/null || sleep 1; i=$((i + 1)); done
  i=0
  while [ $i -lt 40 ]; do
    usleep 500000 2>/dev/null || sleep 1
    i=$((i + 1))
    f=$(front)
    case "$f" in
      "$APP"|"") ;;
      com.webos.app.hdmi*|com.webos.app.livetv|com.webos.app.home|com.webos.app.inputcommon) log "over $f"; launch ;;
      *) return ;;
    esac
  done
}

# After a power cut the TV starts at 1 January with its clock "not set", and LG's own time server (sdp) can take
# minutes to answer while the TV starts. The launcher hides the prayer times until then, so the clock is set from
# the Date of an HTTPS answer as soon as the network is up; LG's server corrects it later by a second or two.
valid() {
  luna-send -n 1 luna://com.palm.systemservice/time/getSystemTime '{}' 2>/dev/null | grep -q '"timeValid": *true'
}
clock() {
  i=0
  while [ $i -lt 180 ] && ! valid; do
    for h in https://api.github.com https://www.google.com; do
      d=$(curl -sI -m 5 $h 2>/dev/null | sed -n 's/^[Dd]ate: *//p' | tr -d '\r')
      u=$(date -u -D "%a, %d %b %Y %H:%M:%S GMT" -d "$d" +%s 2>/dev/null)
      # Only a sane date (after 2024): a captive page could answer anything.
      if [ -n "$u" ] && [ "$u" -gt 1704067200 ]; then
        valid && return
        luna-send -n 1 luna://com.palm.systemservice/clock/setTime "{\"source\":\"sdp\",\"utc\":$u}" 2>/dev/null |
          grep -q '"returnValue": *true' && log "clock set from $h: $d"
        return
      fi
    done
    sleep 2; i=$((i + 1))
  done
}

# ---------------------------------------------------------------- sounds and updates

KEEP=/var/lib/afnon-launcher
REPO=alequab/islamic-launcher-for-lg-tv
mkdir -p $KEEP

# The adhans and spoken lines live in the app's folder, which an install replaces: a copy is kept aside (when the
# app has more of them than the copy) and put back when they are gone.
count() { ls "$1" 2>/dev/null | wc -l; }
# The service runs sealed off from the app's folder, so it has its own copy of the spoken lines.
SVCDIR=/media/developer/apps/usr/palm/services/$APP.service
sounds() {
  [ -d $DIR ] || return
  if [ "$(count $DIR/sounds/adhan)" -gt "$(count $KEEP/sounds/adhan)" ]; then
    rm -rf $KEEP/sounds && cp -r $DIR/sounds $KEEP/sounds && log "sounds kept"
  elif [ "$(count $DIR/sounds/adhan)" -eq 0 ] && [ "$(count $KEEP/sounds/adhan)" -gt 0 ]; then
    rm -rf $DIR/sounds && cp -r $KEEP/sounds $DIR/sounds && log "sounds put back"
  fi
  if [ -d $SVCDIR ] && [ "$(count $SVCDIR/announce)" -lt "$(count $DIR/sounds/announce)" ]; then
    rm -rf $SVCDIR/announce && cp -r $DIR/sounds/announce $SVCDIR/announce && log "service's spoken lines put back"
  fi
}
sounds

# Whether version $1 is newer than $2 (dotted numbers, "1.2.0" > "1.1.9").
newer() {
  awk -v a="$1" -v b="$2" 'BEGIN { n = split(a, x, "."); m = split(b, y, ".");
    for (i = 1; i <= (n > m ? n : m); i++) { if ((x[i] + 0) > (y[i] + 0)) exit 0; if ((x[i] + 0) < (y[i] + 0)) exit 1 }
    exit 1 }'
}

# The latest GitHub release, if newer than the installed launcher: its .ipk installed as Developer Mode installs
# do, then the sounds put back, and this script from the same release. Once a day ($1 = now: at once), and not
# while the launcher is on screen (it would restart under the viewer): then an hour later.
update() {
  stamp=$(date +%s)
  if [ "$1" != now ]; then
    [ $((stamp - $(cat $KEEP/checked 2>/dev/null || echo 0))) -lt 86400 ] && return
    if [ "$(front)" = "$APP" ]; then echo $((stamp - 86400 + 3600)) > $KEEP/checked; return; fi
  fi
  echo $stamp > $KEEP/checked
  json=$(curl -s -m 30 -L "https://api.github.com/repos/$REPO/releases/latest") || return
  tag=$(echo "$json" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
  url=$(echo "$json" | grep -o '"browser_download_url": *"[^"]*\.ipk"' | head -1 | sed 's/.*"\(https[^"]*\)"$/\1/')
  have=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' $DIR/appinfo.json 2>/dev/null)
  [ -n "$tag" ] && [ -n "$url" ] || { log "update: no release"; return; }
  newer "${tag#v}" "${have:-0}" || { log "update: $have is the latest"; return; }
  log "update: $have -> ${tag#v}"
  sounds
  ipk=/tmp/afnon-launcher-update.ipk
  curl -s -m 600 -L -o $ipk "$url" || { log "update: download failed"; return; }
  ilog=/tmp/afnon-launcher-install.log
  luna-send -i luna://com.webos.appInstallService/dev/install \
    "{\"id\":\"com.ares.defaultName\",\"ipkUrl\":\"$ipk\",\"subscribe\":true}" > $ilog 2>&1 &
  i=0
  while [ $i -lt 300 ] && ! grep -q '"installed"\|"failed"\|errorText' $ilog; do sleep 1; i=$((i + 1)); done
  kill $! 2>/dev/null
  if grep -q '"installed"' $ilog; then log "update: installed ${tag#v}"; else log "update: install failed"; fi
  rm -f $ipk $ilog
  perms; icons; sounds
  # This script from the same release, for the next boot (the watcher running now carries on as it is).
  new=/tmp/afnon-launcher-boot
  if curl -s -m 30 -L -o $new "https://raw.githubusercontent.com/$REPO/$tag/boot/90-afnon-launcher" &&
     head -1 $new | grep -q '^#!/bin/sh' && sh -n $new && ! cmp -s $new "$0"; then
    cp $new "$0" && chmod +x "$0" && log "update: boot script updated"
  fi
  rm -f $new
}

# ---------------------------------------------------------------- Home and the clean-up

# LG's Home on webOS 5 is a native program (its appinfo "type": "native"). The stand-in is mounted over it: the app
# manager starts it whenever Home is launched (the Home key, the end of an app), it opens the launcher and stays,
# registered as Home, so a Home key while it runs (a "relaunch") opens the launcher again.
HOMEAPP=/usr/palm/applications/com.webos.app.home/appinfo.json
HOMEEXE=/usr/bin/com.webos.app.home
STANDIN=$KEEP/home-standin
standin() {
  cat > $STANDIN <<'EOF'
#!/bin/sh
# Afnon LG's stand-in for LG's Home program (mounted over it in RAM by 90-afnon-launcher).
APP=tv.afnon.launcher
log() { echo "$(date +%H:%M:%S) home stand-in: $*" >> /tmp/afnon-launcher.log; }
for p in $(pgrep -f "^/bin/sh $0"); do [ "$p" != $$ ] && kill "$p" 2>/dev/null; done
pkill -f "[l]una-send -i -a com.webos.app.home" 2>/dev/null
show() {
  luna-send -n 1 -w 8000 luna://com.webos.applicationManager/launch "{\"id\":\"$APP\"}" </dev/null 2>/dev/null |
    grep -q '"returnValue": *true' && log "launcher opened ($1)" || log "launcher did not open ($1)"
}
show start
for m in registerApp registerNativeApp; do
  luna-send -i -a com.webos.app.home "luna://com.webos.applicationManager/$m" '{}' </dev/null 2>&1 | while read -r line; do
    case "$line" in
      *'"event"'*relaunch*) show "Home key" ;;
      *'"event"'*close*) kill $$ 2>/dev/null; exit 0 ;;
      *'"returnValue"'*false*) log "$m refused" ;;
    esac
  done
done
# Not registered: the app manager starts this again on the Home key, which opens the launcher the same way.
while :; do sleep 60; done
EOF
  chmod 755 $STANDIN
}
isHome() { grep -q " $HOMEEXE " /proc/mounts; }

takeHome() {
  [ -f $KEEP/no-home ] && { log "Home: left to LG (no-home)"; return 1; }
  isHome && return 0
  grep -q '"type": *"native"' $HOMEAPP 2>/dev/null && [ -f $HOMEEXE ] || { log "Home: LG's Home is not a native program here; left to LG"; return 1; }
  standin
  mount --bind $STANDIN $HOMEEXE || { log "Home: the mount failed"; return 1; }
  # LG's Home running now is its own program: stopped once; from now on the app manager starts the stand-in.
  for p in $(pgrep -f "^$HOMEEXE"); do kill "$p" 2>/dev/null; done
  log "Home: the launcher is Home"
  # The stand-in must be running within 30 s (it starts on the next Home launch, asked for here), or LG's Home
  # comes back until the next restart.
  ( sleep 3
    luna-send -n 1 -w 10000 luna://com.webos.applicationManager/launch '{"id":"com.webos.app.home"}' </dev/null >/dev/null 2>&1
    i=0
    until pgrep -f "^/bin/sh $HOMEEXE" >/dev/null || [ $i -ge 15 ]; do sleep 2; i=$((i + 1)); done
    pgrep -f "^/bin/sh $HOMEEXE" >/dev/null || { log "Home: the stand-in did not start"; lgHome; } ) &
  return 0
}

# LG's Home back until the next restart (the clean-up is lifted first: LG's Home needs the ad services).
lgHome() {
  clean undo
  isHome || return 0
  # The stand-in first: while it runs from the mount, the mount is busy.
  i=0
  while isHome && [ $i -lt 5 ]; do
    for p in $(pgrep -f "^/bin/sh $HOMEEXE"); do kill "$p" 2>/dev/null; done
    pkill -f "[l]una-send -i -a com.webos.app.home" 2>/dev/null
    sleep 1
    umount $HOMEEXE 2>/dev/null
    i=$((i + 1))
  done
  isHome && { log "Home: the stand-in could not be removed (it goes at the next restart)"; return 1; }
  luna-send -n 1 -w 10000 luna://com.webos.applicationManager/launch '{"id":"com.webos.app.home"}' </dev/null >/dev/null 2>&1
  log "Home: LG's Home is back"
}

# The clean-up ($1 = undo lifts it). Programs the TV starts when it wants them get a do-nothing stub mounted over
# them; services that run all the time are stopped; the ad servers go to 127.0.0.1 in a RAM copy of /etc/hosts.
STUB=$KEEP/stub
BLOCK='admanager adoverlay-service acr2 sportsalarm'
UNITS='remotelogger service-logger contentminer nudge'
ADS='eic.ads.lgtvcommon.com nl.ad.lgsmartad.com nl.info.lgsmartad.com'
clean() {
  if [ "$1" = undo ]; then
    for b in $BLOCK; do grep -q " /usr/sbin/$b " /proc/mounts && umount /usr/sbin/$b; done
    grep -q ' /etc/hosts ' /proc/mounts && umount /etc/hosts
    for u in $UNITS; do systemctl --no-block start $u.service >/dev/null 2>&1; done
    return 0
  fi
  [ -f $KEEP/no-debloat ] && return 0
  printf '#!/bin/sh\nexit 0\n' > $STUB; chmod 755 $STUB
  for b in $BLOCK; do
    [ -f /usr/sbin/$b ] || continue
    grep -q " /usr/sbin/$b " /proc/mounts || mount --bind $STUB /usr/sbin/$b
    pkill -9 -f "^/usr/sbin/$b"
  done
  # --no-block: contentminer can take a minute to stop.
  for u in $UNITS; do systemctl --no-block stop $u.service >/dev/null 2>&1; done
  if ! grep -q 'afnon-launcher' /etc/hosts; then
    cp /etc/hosts /tmp/afnon-hosts &&
      { echo "127.0.0.1 $ADS # afnon-launcher"; echo "::1 $ADS # afnon-launcher"; } >> /tmp/afnon-hosts &&
      mount --bind /tmp/afnon-hosts /etc/hosts
  fi
  log "clean-up: LG's ads, LivePlus, telemetry and suggestions stopped"
}

# Icons (and sounds and permissions) again whenever an app is installed, updated or removed (the list's
# subscription says so).
watchApps() {
  while true; do
    luna-send -i luna://com.webos.applicationManager/listLaunchPoints '{"subscribe":true}' 2>/dev/null |
      while read -r line; do
        # A reinstall of either app also resets its permissions.
        case "$line" in *'"change"'*) perms; icons; sounds ;; esac
      done
    sleep 5
  done
}

# Notes in the log when the TV closes the launcher (to see what a long press of Back does). The Home key is left
# to the TV: it opens LG's own Home bar.
watchClose() {
  while true; do
    luna-send -i luna://com.webos.applicationManager/getAppLifeEvents '{"subscribe":true}' 2>/dev/null |
      while read -r line; do
        case "$line" in *'"event":"close"'*"\"appId\":\"$APP\""*) log "closed: $line" ;; esac
      done
    sleep 5
  done
}

watch() {
  first
  # Home, then the clean-up a minute later, once the TV has settled (only while the launcher is Home).
  takeHome && ( sleep 60; isHome && clean ) &
  watchClose &
  valid || { log "clock not set"; clock & }
  watchApps &
  # Updates: a first look 2 minutes after the start, then every hour (update() itself keeps to once a day).
  ( sleep 120; while true; do update; sleep 3600; done ) &
  # Only at boot: run again by hand (a reinstall), it leaves whatever is on screen alone.
  [ "$(cut -d. -f1 /proc/uptime)" -lt 300 ] && bring
  # The power state, as it changes; "Active" (not "Active Standby") is the TV turned on with its screen.
  last=Active
  while true; do
    luna-send -i luna://com.webos.service.tvpower/power/getPowerState '{"subscribe":true}' 2>/dev/null |
      while read -r line; do
        case "$line" in
          *'"state"'*'"Active"'*) [ "$last" = Active ] || { log "on"; bring; }; last=Active ;;
          # Turning off ("Suspend"): Afnon becomes the last input. The launch asked for here is carried out the
          # moment the TV wakes again (the system freezes first), so Afnon is back in front at once.
          *'"state"'*) [ "$last" = Active ] && { log "off"; first; launch; }; last=other ;;
        esac
      done
    sleep 5
  done
}

if [ "$1" = lg-home ]; then
  lgHome
  exit 0
fi

if [ "$1" = update ]; then
  update now
  exit 0
fi

if [ "$1" = watch ]; then
  echo $$ > $PID
  log "watching (pid $$)"
  watch
  exit 0
fi

# One watcher only, also if this script is run again by hand; in its own session, so it outlives the
# shell that started it.
if [ -f $PID ] && grep -q afnon-launcher "/proc/$(cat $PID)/cmdline" 2>/dev/null; then exit 0; fi
setsid "$0" watch </dev/null >/dev/null 2>&1 &
